{
    "compilerOptions": {
        "target": "es2020",
        "moduleResolution": "nodenext",
        "module": "nodenext",
        "resolveJsonModule": true,
        "declaration": true,
        "sourceMap": true,
        "declarationMap": true,
        "outDir": "dist",
        "strict": true,
        "noEmit": true,
        "types": [
            "@adamasvr/sdk",
            "node"
        ]
    },
    "include": [
        "**/*",
        ".adamas/generated.d.ts"
    ]
}